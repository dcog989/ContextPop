{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "scripts/**", "test/**"],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "domains": {
      "types": "all"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      },
      "nursery": {
        "noBaseToString": "error",
        "noFloatingPromises": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisleadingReturnType": "error",
        "noMisusedPromises": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeReturn": "off",
        "noUnsafeUnaryMinus": "error",
        "noUselessTypeAssertion": "error",
        "noUselessTypeConversion": "error",
        "useAwaitThenable": "error",
        "useDisposables": "error",
        "useExhaustiveSwitchCases": "error",
        "useIncludes": "error",
        "useNullishCoalescing": "error",
        "useRegexpExec": "error",
        "useStrictBooleanExpressions": "off",
        "useStringStartsEndsWith": "error"
      },
      "suspicious": {
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/url.js",
        "src/util.js",
        "src/afterAnimation.js",
        "src/messages.js",
        "src/actionIcons.js",
        "src/actions.js",
        "src/defaultEngines.js",
        "src/storage.js",
        "src/engineSource.js",
        "src/opener.js",
        "src/permissions.js",
        "src/icon*.js",
        "src/options*.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  }
}
